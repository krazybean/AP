{
  "name": "ai-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "AI traffic plane for exposing private applications through ordinary HTTPS.",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "mock:downstream": "tsx scripts/mock-downstream.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@upstash/redis": "^1.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
