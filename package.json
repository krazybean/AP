{
  "name": "ai-proxy",
  "version": "1.0.0",
  "description": "AI traffic plane for exposing private applications through ordinary HTTPS.",
  "license": "MIT",
  "author": "Juan Castro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krazybean/AP.git"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:redis": "AP_TEST_BROKER=redis AP_REDIS_INTEGRATION=1 node --import tsx --test test/*.test.ts",
    "mock:downstream": "tsx scripts/mock-downstream.ts",
    "login": "node scripts/login.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "security:load": "node --import tsx scripts/security-load.ts"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@upstash/redis": "^1.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
